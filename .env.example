# Telegram
# Required. Get this from @BotFather.
BOT_TOKEN=your_telegram_bot_token_here

# Optional. Leave blank to skip admin notifications in demo mode.
ADMIN_CHAT_ID=

# Google Sheets
# Optional. Leave SPREADSHEET_ID blank to run without Google Sheets.
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=
SHEET_NAME=Leads

# Portfolio
# Optional. Add the real GitHub URL after publishing.
GITHUB_URL=
